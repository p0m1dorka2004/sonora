                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Заключение" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="формулируется на основе показателей" FontSize="9"
                                                   Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource PillAccent}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="8"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Сформировано" Style="{StaticResource PillTextAccent}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel Margin="13,13,13,8">
                                <Border Style="{StaticResource FieldCell}" Margin="5">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="ЗАКЛЮЧЕНИЕ" Style="{StaticResource FieldLabel}"/>
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource GreenDotBrush}" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" ToolTip="Сформировано на основе распознанных показателей"/>
                                        </Grid>
                                        <TextBox Style="{StaticResource TextAreaInput}" MinHeight="46"
                                                 Text="Эхо-признаки диффузных изменений поджелудочной железы (повышение эхогенности). Очаговой патологии органов брюшной полости не выявлено."/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FieldCell}" Margin="5">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="РЕКОМЕНДАЦИИ" Style="{StaticResource FieldLabel}"/>
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource GreenDotBrush}" HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" ToolTip="Распознано · уверенность 93%"/>
                                        </Grid>
                                        <TextBox Style="{StaticResource TextAreaInput}" MinHeight="28"
                                                 Text="Контроль УЗИ через 6 месяцев. Консультация гастроэнтеролога по клиническим показаниям."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Протокол сохраняется в локальное хранилище. Передача данных во внешние сервисы не выполняется."
                               FontSize="9" Foreground="{DynamicResource FaintBrush}" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ====================  ПРАВАЯ ПАНЕЛЬ  ==================== -->
            <Border Grid.Row="1" Grid.Column="2"
                    Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer Style="{StaticResource CleanScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,18,12,20">

                        <!-- Распознавание -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Распознавание" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="Compact · локальная модель" FontSize="9" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="RecognitionPill" Style="{StaticResource PillAccent}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="RecognitionDot" Width="5" Height="5" Fill="{DynamicResource GreenDotBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="RecognitionStatusText" Text="Готово" Style="{StaticResource PillTextAccent}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,11,0,9"/>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Язык" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Русский (ru-RU)" FontSize="10.5" Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Режим" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Офлайн · на устройстве" FontSize="10.5" Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Уровень сигнала" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock x:Name="LevelValueText" Text="−32 дБ" FontSize="10" Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="3" Margin="0,6,0,0">
                                    <Border Background="{DynamicResource TrackBrush}" CornerRadius="1.5"/>
                                    <Border x:Name="LevelFill" Width="96" Background="{DynamicResource AccentBrush}"
                                            CornerRadius="1.5" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Транскрипт -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ТРАНСКРИПТ" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Padding="6,1" Margin="7,0,0,0">
                                            <TextBlock Text="12" Style="{StaticResource PillText}" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Style="{StaticResource LinkButton}" Content="Показать всё" HorizontalAlignment="Right"
                                            Click="ShowAllTranscript_Click"/>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                <StackPanel Margin="0,9,0,0">
                                    <Grid>
                                        <TextBlock Text="12:04:18" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                                   Foreground="{DynamicResource FaintBrush}"/>
                                        <TextBlock Text="97%" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="«Печень не увеличена, контуры ровные, эхогенность средняя»"
                                               FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                               LineHeight="16.5" Margin="0,3,0,0"/>
                                    <TextBlock Text="→ Печень · 3 поля" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>

                                    <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="12:04:26" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                                   Foreground="{DynamicResource FaintBrush}"/>
                                        <TextBlock Text="94%" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="«Жёлчный пузырь грушевидной формы, стенка два миллиметра, содержимое однородное»"
                                               FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                               LineHeight="16.5" Margin="0,3,0,0"/>
                                    <TextBlock Text="→ Жёлчный пузырь · 3 поля" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>

                                    <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="12:04:33" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                                   Foreground="{DynamicResource FaintBrush}"/>
                                        <TextBlock Text="88%" FontSize="8.5" Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="«Холедох четыре миллиметра»" FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}"
                                               TextWrapping="Wrap" LineHeight="16.5" Margin="0,3,0,0"/>
                                    <TextBlock Text="→ Холедох · 1 поле" FontSize="9.5" Foreground="{DynamicResource AmberBrush}" Margin="0,4,0,0"/>

                                    <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="12:04:41" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                                   Foreground="{DynamicResource FaintBrush}"/>
                                        <TextBlock Text="92%" FontSize="8.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="«Поджелудочная: головка двадцать четыре, тело шестнадцать, хвост двадцать два»"
                                               FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                                               LineHeight="16.5" Margin="0,3,0,0"/>
                                    <TextBlock Text="→ Поджелудочная железа · 3 поля" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Требует проверки -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ТРЕБУЕТ ПРОВЕРКИ" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource PillAmber}" HorizontalAlignment="Right" Padding="7,1">
                                        <TextBlock Text="2" Style="{StaticResource PillTextAmber}" FontSize="9"/>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Холедох" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="4 мм · уверенность 88%" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="11,2,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource LinkButton}" Content="Перейти" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Click="FocusField_Click" Tag="CholedochInput"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,9,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Стенка жёлчного пузыря" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="2 мм · уверенность 90%" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Margin="11,2,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource LinkButton}" Content="Перейти" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Click="FocusField_Click" Tag="GallbladderWallInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Команды -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ГОЛОСОВЫЕ КОМАНДЫ" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Настроить" HorizontalAlignment="Right"
                                            Click="Stub_Click" Tag="Настройка голосовых команд"/>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,9,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="F9" Style="{StaticResource KeycapText}"/></Border>
                                        <TextBlock Text="начать запись" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,9">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}"/></Border>
                                        <TextBlock Text="остановить" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Tab" Style="{StaticResource KeycapText}"/></Border>
                                        <TextBlock Text="следующее поле" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="сброс" Style="{StaticResource KeycapText}"/></Border>
                                        <TextBlock Text="очистить поле" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Команды произносятся во время диктовки без остановки записи."
                                           FontSize="9" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ====================  НИЖНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ  ==================== -->
            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource TopBarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,0,20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenDotBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Черновик сохранён локально" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                        <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="14,0"/>
                        <TextBlock Text="Проверено 28 из 30 полей" FontSize="10" Foreground="{DynamicResource InkSoftBrush}"/>
                        <Grid Width="90" Height="3" Margin="9,0,0,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="1.5"/>
                            <Border Width="80" Background="{DynamicResource AccentBrush}" CornerRadius="1.5" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock Text="93%" FontSize="9" Foreground="{DynamicResource FaintBrush}" Margin="7,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Height="34" Click="Preview_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Предпросмотр" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="34" Content="Сохранить черновик"
                                Click="Save_Click" Margin="0,0,8,0" ToolTip="Сохранить черновик (Ctrl+S)"/>
                        <Button Style="{StaticResource PrimaryButton}" Height="34" Click="Finish_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="10" Margin="0,0,7,0"/>
                                <TextBlock Text="Завершить протокол" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
