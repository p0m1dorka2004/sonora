<Window x:Class="vkr.Dialogs.ModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SONORA"
        Width="540"
        SizeToContent="Height"
        MaxHeight="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Border Margin="28"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.20" Color="#101C18"/>
        </Border.Effect>

        <Grid Margin="26,22,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandMarkBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="2.5" Height="7" CornerRadius="1.25" Background="{DynamicResource MintBrush}" Margin="0,0,2,0"/>
                            <Border Width="2.5" Height="13" CornerRadius="1.25" Background="#F4F1EA" Margin="0,0,2,0"/>
                            <Border Width="2.5" Height="9" CornerRadius="1.25" Background="{DynamicResource MintBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="S O N O R A" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="ЛОКАЛЬНЫЕ МОДЕЛИ" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CaptionButton}"
                        Width="30" Height="30" Click="Close_Click" ToolTip="Закрыть">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="Модель распознавания" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,18,20,0"/>

            <TextBlock Grid.Row="2" Text="Три локальных движка. Аудио не покидает устройство; сеть и API не используются."
                       FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"
                       LineHeight="18" Margin="0,7,18,0"/>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="ДВИЖОК" FontSize="8.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource FaintBrush}"/>

                <RadioButton x:Name="WhisperEngineRadio" GroupName="Engine" Margin="0,8,0,0"
                             Foreground="{DynamicResource InkBrush}" FontSize="12.5"
                             Checked="Engine_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Whisper Small" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="whisper.cpp · 466 МБ · быстрый" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="GigaAmEngineRadio" GroupName="Engine" Margin="0,8,0,0"
                             Foreground="{DynamicResource InkBrush}" FontSize="12.5"
                             Checked="Engine_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="GigaAM v3" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="ONNX Runtime · 225 МБ · русский, пунктуация" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="GigaAmRnntEngineRadio" GroupName="Engine" Margin="0,8,0,0"
                             Foreground="{DynamicResource InkBrush}" FontSize="12.5"
                             Checked="Engine_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="GigaAM v3 RNN-T" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="ONNX Runtime · 226 МБ · точнее, русский" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Border Grid.Row="4" Margin="0,18,0,0" CornerRadius="8"
                    Background="{DynamicResource AccentTintBrush}" Padding="11,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                    <TextBlock x:Name="ModelNoteText" Text="Whisper Small · 466 МБ · whisper.cpp · офлайн"
                               FontSize="10.5" Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap" MaxWidth="370" LineHeight="15"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" Margin="0,22,0,0">
                <TextBlock Text="Движок применяется сразу" FontSize="9.5"
                           Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="96" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Применить" Width="112" Style="{StaticResource PrimaryButton}"
                            Click="Apply_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
