<Window x:Class="vkr.Dialogs.StubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SONORA"
        Width="470"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Border Margin="28"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.20" Color="#101C18"/>
        </Border.Effect>

        <Grid Margin="26,22,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandMarkBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="2.5" Height="7" CornerRadius="1.25" Background="{DynamicResource MintBrush}" Margin="0,0,2,0"/>
                            <Border Width="2.5" Height="13" CornerRadius="1.25" Background="#F4F1EA" Margin="0,0,2,0"/>
                            <Border Width="2.5" Height="9" CornerRadius="1.25" Background="{DynamicResource MintBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="S O N O R A" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="ПРОТОТИП ИНТЕРФЕЙСА" FontSize="7.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CaptionButton}"
                        Width="30" Height="30" Click="Close_Click" ToolTip="Закрыть">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="9"/>
                </Button>
            </Grid>

            <TextBlock x:Name="TitleText" Grid.Row="1"
                       FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                       TextWrapping="Wrap" Margin="0,18,20,0"/>

            <TextBlock x:Name="MessageText" Grid.Row="2"
                       FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}"
                       TextWrapping="Wrap" LineHeight="19" Margin="0,8,18,0"/>

            <Border Grid.Row="3" Margin="0,18,0,0" CornerRadius="8"
                    Background="{DynamicResource AccentTintBrush}" Padding="11,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                    <TextBlock x:Name="NoteText"
                               FontSize="10.5" Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap" MaxWidth="315" LineHeight="15"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <TextBlock Text="Действие отмечено заглушкой" FontSize="9.5" Foreground="{DynamicResource FaintBrush}"
                           VerticalAlignment="Center"/>
                <Button x:Name="OkButton" Content="Понятно" Width="112" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
